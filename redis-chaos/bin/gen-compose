#!/usr/bin/env bash
# Writes docker-compose.yml for 3 DCs x 3 shards, plus a spare node per DC. Run from anywhere.
set -euo pipefail
cd "$(dirname "$0")/.."
{
cat <<'EOF'
# Generated by bin/gen-compose. Edit the generator, not this file.
#
# Every redis node lives alone in its own /24 and routes through `router`,
# so the router sees (and can drop/delay) every packet, including traffic
# between two nodes of the same DC.
#
#   node   rc-dc<D>-s<S>   10.77.<D><S>.10   (designated master: D == S)
#   client rc-client       10.77.100.10
#   router rc-router       .254 on every subnet

name: redis-chaos

# Only the router carries `build:`; everything else reuses its image
# (bin/chaos up builds it first).
x-node: &node
  image: redis-chaos:8.2.2
  pull_policy: never
  entrypoint: ["/usr/local/bin/entrypoint-node.sh"]
  cap_add: [NET_ADMIN]
  volumes:
    - ./conf/redis.conf:/etc/redis/redis.conf:ro
  depends_on: [router]
  stop_grace_period: 3s

services:
  router:
    image: redis-chaos:8.2.2
    build: ./image
    container_name: rc-router
    hostname: router
    entrypoint: ["/usr/local/bin/entrypoint-router.sh"]
    cap_add: [NET_ADMIN]
    sysctls:
      net.ipv4.ip_forward: 1
    stop_grace_period: 1s
    networks:
EOF
for d in 1 2 3; do for s in 1 2 3 4; do echo "      n$d$s: { ipv4_address: 10.77.$d$s.254 }"; done; done
echo "      client: { ipv4_address: 10.77.100.254 }"
cat <<'EOF'

  client:
    image: redis-chaos:8.2.2
    pull_policy: never
    container_name: rc-client
    hostname: client
    entrypoint: ["/usr/local/bin/entrypoint-client.sh"]
    cap_add: [NET_ADMIN]
    environment: { GATEWAY: 10.77.100.254 }
    volumes:
      - ./client/target/x86_64-unknown-linux-musl/release:/app:ro
    depends_on: [router]
    stop_grace_period: 1s
    networks:
      client: { ipv4_address: 10.77.100.10 }
EOF
# s4 nodes are spares: started, not in the cluster, for add/remove-node tests.
for d in 1 2 3; do for s in 1 2 3 4; do cat <<EOF

  dc$d-s$s:
    <<: *node
    container_name: rc-dc$d-s$s
    hostname: dc$d-s$s
    environment: { GATEWAY: 10.77.$d$s.254 }
    networks:
      n$d$s: { ipv4_address: 10.77.$d$s.10 }
EOF
done; done
echo; echo "networks:"
for d in 1 2 3; do for s in 1 2 3 4; do cat <<EOF
  n$d$s:
    internal: true
    ipam: { config: [{ subnet: 10.77.$d$s.0/24, gateway: 10.77.$d$s.1 }] }
EOF
done; done
cat <<'EOF'
  client:
    internal: true
    ipam: { config: [{ subnet: 10.77.100.0/24, gateway: 10.77.100.1 }] }
EOF
} > docker-compose.yml
echo "wrote docker-compose.yml"
